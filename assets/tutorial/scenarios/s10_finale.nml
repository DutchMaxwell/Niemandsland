@2434","network_id":2000030.0,"position":[-0.0631998777389526,0.0,-0.355599999427795],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.10194_1016006610","glb_name":"Warriors","model_index":9.0,"name":"@StaticBody3D@2436","network_id":2000031.0,"position":[-0.0231999158859253,0.0,-0.355599999427795],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.11437_2882921350","glb_name":"Warriors","model_index":0.0,"name":"OPR_Warriors_(2)","network_id":2000032.0,"position":[0.0232000350952148,0.0,-0.355600029230118],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.11437_2882921350","glb_name":"Warriors","model_index":1.0,"name":"@StaticBody3D@2439","network_id":2000033.0,"position":[0.063200056552887,0.0,-0.355600029230118],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.11437_2882921350","glb_name":"Warriors","model_index":2.0,"name":"@StaticBody3D@2441","network_id":2000034.0,"position":[0.103200018405914,0.0,-0.355600029230118],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.11437_2882921350","glb_name":"Warriors","model_index":3.0,"name":"@StaticBody3D@2443","network_id":2000035.0,"position":[0.143200039863586,0.0,-0.355600029230118],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.11437_2882921350","glb_name":"Warriors","model_index":4.0,"name":"@StaticBody3D@2445","network_id":2000036.0,"position":[0.183200061321259,0.0,-0.355600029230118],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.11437_2882921350","glb_name":"Warriors","model_index":5.0,"name":"@StaticBody3D@2447","network_id":2000037.0,"position":[0.223200023174286,0.0,-0.355600029230118],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.11437_2882921350","glb_name":"Warriors","model_index":6.0,"name":"@StaticBody3D@2449","network_id":2000038.0,"position":[0.263200044631958,0.0,-0.355600029230118],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.11437_2882921350","glb_name":"Warriors","model_index":7.0,"name":"@StaticBody3D@2451","network_id":2000039.0,"position":[0.303200006484985,0.0,-0.355600029230118],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.11437_2882921350","glb_name":"Warriors","model_index":8.0,"name":"@StaticBody3D@2453","network_id":2000040.0,"position":[0.343200087547302,0.0,-0.355600029230118],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.11437_2882921350","glb_name":"Warriors","model_index":9.0,"name":"@StaticBody3D@2455","network_id":2000041.0,"position":[0.38320004940033,0.0,-0.355600029230118],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.27362_1712311895","glb_name":"Snipers","model_index":0.0,"name":"OPR_Snipers","network_id":2000042.0,"position":[-0.0399999618530273,0.0,-0.406399995088577],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.27362_1712311895","glb_name":"Snipers","model_index":1.0,"name":"@StaticBody3D@2458","network_id":2000043.0,"position":[0.0,0.0,-0.406399995088577],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true},{"game_unit_id":"1793359468.27362_1712311895","glb_name":"Snipers","model_index":2.0,"name":"@StaticBody3D@2460","network_id":2000044.0,"position":[0.0400000810623169,0.0,-0.406399995088577],"rotation":[0.0,0.0,0.0],"type":"opr_unit","visible":true}],"player_spells":{"1":[{"effect":"Pick one friendly unit within 12\", which gets Evasive once (next time the effect would apply).","name":"Protective Dome","threshold":1.0},{"effect":"Pick one enemy unit within 6\", which takes 3 hits with Bane.","name":"Psychic Terror","threshold":1.0},{"effect":"Pick up to two enemy units within 18\" in line of sight, which friendly units gets Unstoppable on their weapons when shooting against once (next time the effect would apply).","name":"Advanced Sight","threshold":2.0},{"effect":"Pick up to two enemy units within 9\", which take 4 hits each.","name":"Lightning Fog","threshold":2.0},{"effect":"Pick up to three friendly units within 18\", which get Shred on its weapons when shooting once (next time the effect would apply).","name":"Blessed Ammo","threshold":3.0},{"effect":"Pick one enemy unit within 24\" in line of sight, which takes 6 hits with AP(1) and Smash.","name":"Cerebral Trauma","threshold":3.0}],"2":[{"effect":"Pick one enemy unit within 18\" in line of sight, which friendly units gets Indirect on their weapons against once (next time the effect would apply).","name":"Triangulation Bots","threshold":1.0},{"effect":"Pick one enemy unit within 6\", which takes 3 hits with AP(1) and Shatter. Roll as many dice as hits to see if \"on rolls of 6\" effects trigger.","name":"Gauss Bots","threshold":1.0},{"effect":"Pick up to two friendly units within 12\", which get Rapid Advance once (next time the effect would apply).","name":"Inspiring Bots","threshold":2.0},{"effect":"Pick up to two enemy units within 9\", which take 4 hits each.","name":"Flame Bots","threshold":2.0},{"effect":"Pick up to three friendly units within 18\", which get Enhanced Self-Repair once (next time the effect would apply).","name":"Mending Bots","threshold":3.0},{"effect":"Pick one enemy unit within 18\" in line of sight, which takes 6 hits with AP(2).","name":"Piercing Bots","threshold":3.0}]},"rule_descriptions":{"AP":"AP","Agile":"Moves +1” on Advance and +2” on Rush/Charge actions.","Aircraft":"May only use Advance actions, moving in a straight line, and adding 30” to its total move (even if Shaken). Aircraft ignore all units and terrain when moving and stopping, can’t seize or contest objectives, can’t be charged, and units targeting them get -12” range and -1 to hit rolls.","Ambush":"May be set aside before deployment. At the start of any round after the first, may be deployed anywhere over 9” away from enemy units. Players alternate in placing Ambush units, starting with the player that activates next. Units that deploy via Ambush can’t seize or contest objectives on the round they deploy.","Ambush Aura":"This model and its unit get Ambush.","Ambushing Piercing Shot":"Counts as having Ambush, and its weapons get AP(+1) when shooting on the round in which it deploys via this rule.","Anti-Cover":"This weapon ignores Cover.","Anti-Regen":"This weapon ignores Regeneration.","Armor":"Counts as having Defense X+.","Artillery":"When this model uses Hold actions and shoots at enemies over 12” away, it gets +1 to hit rolls. If most models in this unit have this rule, as long as they haven't moved during this round, enemy units shooting at them from over 12” away get -1 to hit rolls.","Assault":"Counts as both a ranged weapon and a melee weapon.","Bane":"Ignores Regeneration, and when attacking, the target must re-roll unmodified Defense results of 6.","Bane in Melee Aura":"This model and its unit get Bane on its weapons in melee.","Bane when Shooting Aura":"This model and its unit get Bane on its weapons when shooting.","Banner":"This model and its unit get +1 to Morale Test rolls triggered by shooting/melee.","Battleborn":"If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4+, it stops being Shaken.","Berserker":"Once per game, the Hero and its unit may ignore becoming Fatigued.","Blast":"Ignores Cover, and after resolving other special rules, each hit is multiplied by X, where X is up to as many hits as models in the target unit.","Blinded":"Gets -1 to hit rolls when using move actions and shooting.","Brace":"Enemies charging this unit get -X total Impact rolls, unless this unit is Fatigued.","Bravery Aura":"This model and its unit get +1 to Morale Test rolls.","Caster":"Gets X spell tokens at the start of each round, but can’t have more than 6 at once. Once per activation, before attacking, spend as many tokens as the spell’s value to try casting one or more spells (only one try per spell). Pick a target and roll one die, and on 4+ resolve the spell’s effect. Models within 18” of the Caster may spend any number of spell tokens at the same time before rolling to give the Caster +1/-1 to the roll per token.","Casting Buff":"Once per activation, before attacking, pick one friendly model within 12\" with Caster, which gets +1 to casting rolls once (next time the effect would apply).","Chemist":"The Hero and its unit get +1 to Defense rolls when shot.","Counter":"May strike first with this weapon when charged, unless this unit is Fatigued.","Crazed":"Gets +1 to hit rolls in melee when charging.","Crippled":"Moves -1” on Advance and -2” on Rush/Charge actions.","Cumbersome":"May only use Hold or Advance actions, but can’t shoot when moving.","Dead":"Remove the Hero from your army.","Deadly":"Assign each wound to one model, and multiply it by X. Hits from Deadly must be resolved first, and these wounds don’t carry over to other models if the original target is killed.","Defense":"This model gets +X to Defense rolls.","Destroyer":"The Hero and its unit get AP(+1) when using move actions and shooting.","Duellist":"The Hero and its unit get AP(+1) in melee when charged.","Elite":"May re-roll one roll of any kind once per game.","Enhanced Protected":"If most models in this unit have Protected, they ignore wounds on rolls of 5-6 from Protected (instead of only on 6+).","Enhanced Self-Repair":"If most models in this unit have Self-Repair, they ignore wounds on rolls of 5-6 from Self-Repair (instead of only on 6+).","Enhanced Self-Repair Buff":"Once per activation, before attacking, pick one friendly unit within 12\", which gets Enhanced Self-Repair once (next time the effect would apply).","Evasive":"Enemies get -1 to hit rolls when attacking units where most models have this rule.","Explorer":"Once per game, the Hero and its unit ignore the effects of Difficult and Dangerous terrain.","Fanatic":"The Hero and its unit get AP(+1) in melee when charging.","Fast":"Moves +2” when using Advance, and +4” when using Rush/Charge.","Fast Learner":"May pick any other trait from the list.","Fear":"When in melee with this model, enemies count as having taken +X wounds when checking who won.","Fearless":"When a unit where most models have this rule fails a Morale Test, roll one die. On a 4+ it counts as passed instead.","Flying":"May move through units and terrain, and ignores the effects of Difficult and Dangerous terrain.","Furious":"When charging, unmodified result of 6 to hit deal 1 extra hit (only the original hit counts as a 6 for special rules).","Headstrong":"Gets +1 to rolls when taking Morale Tests.","Healer":"Once per game, when the Hero’s unit is activated, it may restore D3 models/wounds.","Herbalist":"The Hero and its unit get +1 to Defense rolls in melee.","Hero":"Heroes with up to Tough(6) may deploy as part of one multi-model unit without another Hero, but must use the unit’s Defense until all other models have been killed. The Hero’s unit, and units within 6” of friendly Heroes with Tough(9) or higher, may use the Hero’s Quality for Morale Tests as long as the Hero isn’t Shaken.","Idol":"Once per game, the Hero and its unit may ignore becoming Shaken.","Immobile":"May only use Hold actions.","Impact":"When charging, before either unit attacks, roll X dice, unless this unit is Fatigued. For each 2+ the target takes 1 hit.","Imprecise":"Gets -1 to hit when attacking.","Indirect":"When using Hold actions and shooting, may target enemies that are not in line of sight as if in line of sight, and ignores Cover from Sight Blockers.","Indirect Mark":"Once per activation, before attacking, pick one enemy unit within 18\" in line of sight, which friendly units gets Indirect on their weapons against once (next time the effect would apply).","Infiltrate":"Counts as having Ambush, but may be deployed anywhere over 3\" away from enemy unit.","Leader":"The Hero and its unit get +1 to Morale Test rolls in melee.","Learned Lesson":"May pick any other trait from the list.","Limited":"May only be used once per game.","Lucky Break":"May pick any other trait from the list.","Maimed":"Gets -1 to hit rolls when fighting in melee.","Mastermind":"Once per game, when the Hero’s unit is targeted by an enemy, it may force the enemy to re-roll one roll of any kind.","Melee Shrouding":"When a unit where most models have this rule is targeted by an enemy unit for charging, that enemy unit gets -2\" range to a min. of 6\".","Melee Shrouding Aura":"This model and its unit get Melee Shrouding.","Mend":"Once per activation, before attacking, pick one friendly model within 3\" with Tough, and remove D3 wounds from it.","Motivated":"Gets +1 to rolls when taking Morale Tests.","Motivator":"The Hero and its unit get +1 to Morale Test rolls triggered by shooting.","Musician":"This model and its unit moves +1\" when using move actions.","Natural Talent":"Earns +1 XP.","No Retreat":"When a unit where most models have this rule fails a Morale Test that causes it to be Shaken or Routed, the test counts as passed instead. Then, roll as many dice as the number of wounds it would take to fully destroy it, and for each result of 1-3 the unit takes one wound, which can't be ignored.","No Retreat Aura":"This model and its unit get No Retreat.","Parry":"When this unit takes hits in melee, roll X dice per model with this rule in it, up to as many dice as hits taken. For each 6+ one hit is ignored (defender picks which).","Piercing Charge":"This model gets AP(+1) on its weapons when charging.","Piercing Charge Aura":"This model and its unit get Piercing Charge.","Protected":"When a unit where most models have this rule takes wounds, roll one die for each. On a 6+ it is ignored.","Protection Feat":"Once per game, when this unit takes wounds and most of its models have this rule, you may use this rule and roll one die per wound, and on a 5+ it is ignored.","Protection Feat Aura":"This model and its unit get Protection Feat.","Prowler":"The Hero and its unit move +1” on Advance actions.","Rapid Advance":"This model moves +4\" when using Advance actions.","Rapid Rush":"This model moves +6\" when using Rush actions.","Rapid Rush Aura":"This model and its unit get Rapid Rush.","Ravage":"Once per round, when it’s this model’s turn to strike in melee, roll X dice before attacking, unless this unit is Fatigued. For each 6+ the target takes one wound.","Re-Deployment":"After all other units are deployed (excluding units that were set aside), you may remove up to two friendly units from the table and deploy them again. Players alternate in placing Re-Deployment units, starting with the player that activates next.","Reanimation":"When a unit where all models have this rule is activated, roll as many dice as the max. number of models/wounds it could restore. For each 5+ you may restore one model/wound. Note that new models may only be restored if they can be placed in coherency with non-restored models.","Reanimation Aura":"This model and its unit get Reanimation.","Regeneration":"When a unit where most models have this rule takes wounds, roll one die for each. On a 5+ it is ignored.","Regeneration Aura":"This model and its unit get Regeneration.","Relentless":"When this model shoots at enemies over 9” away, unmodified result of 6 to hit deal 1 extra hit (only the original hit counts as a 6 for special rules).","Relentless Aura":"This model and its unit get Relentless.","Reliable":"Attacks at Quality 2+.","Rending":"Ignores Regeneration, and for each unmodified result of 6 to hit, those hits get AP(+4).","Rending in Melee":"This model gets Rending on its weapons in melee.","Repel Ambushers":"Enemy units using Ambush must be set up over 12\" away from this model's unit.","Resilient":"Gets +1 to Defense rolls when blocking hits.","Runner":"The Hero and its unit move +2” on Rush/Charge actions.","Scout":"May be set aside before deployment. After all other units are deployed, may be deployed anywhere fully within 9” of their deployment zone, over 9” away from non-Scout enemy units. Players alternate in placing Scout units, starting with the player that activates next.","Self-Repair":"When a unit where most models have this rule takes wounds, roll one die for each. On a 6+ it is ignored.","Sharpshooter":"Once per game, the Hero and its unit get +12” range when shooting.","Shatter":"For each unmodified result of 6 to hit, those hits get AP(+3).","Shred":"For each unmodified result of 1 to block hits, this weapon deals 1 extra wound.","Slow":"Moves -2” when using Advance, and -4” when using Rush/Charge.","Smash":"When attacking units over half of this weapon's range away, the target must re-roll unmodified Defense results of 6.","Spawn":"Once per game, when this model is activated, you may place a new unit of X fully within 6\" of it. Units placed via Spawn can’t seize or contest objectives on the round they are placed.","Specialist":"Gets +1 to hit rolls when in melee or when shooting (pick one).","Spell Amplifier":"Gets +1 to casting rolls.","Steadfast":"If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4+, it stops being Shaken.","Stealth":"When units where most models have this rule are shot from over 9\" away, enemy units get -1 to hit rolls.","Stealth Aura":"This model and its unit get Stealth.","Stealth Buff":"Once per activation, before attacking, pick one friendly unit within 12\", which gets Stealth once (next time the effect would apply).","Strategist":"Once per game, the Hero and its unit may re-roll one roll of any kind when shooting.","Strider":"May ignore the effects of Difficult terrain.","Suppressor":"The Hero and its unit get AP(+1) when using Hold and shooting.","Surge":"For each unmodified result of 6 to hit, this weapon deals 1 extra hit (only the original hit counts as a 6 for special rules).","Swift":"This model may ignore the Slow rule.","Swift Buff":"Once per activation, before attacking, pick one friendly unit within 12\", which gets Swift once (next time the effect would apply).","Tactician":"Once per game, the Hero and its unit may re-roll one roll of any kind in melee.","Takedown":"This model may pick any model in the target unit as its individual target for this weapon's attacks, which is resolved as if it was a unit of [1]. Takedown attacks must be resolved before other weapons.","Thrust":"When charging, gets +1 to hit rolls and AP(+1) in melee.","Tough":"This model must take X wounds before being killed. If a model with Tough joins a unit without it, then it is removed last when the unit takes wounds. You must continue to put wounds on the Tough model with most wounds in the unit until it is killed, before starting to put them on the next Tough model (Heroes must be assigned wounds last, even if already wounded).","Toughened":"Gets Tough(+3).","Transport":"May transport up to X friendly models or Heroes with up to Tough(6), and non-Heroes with up to Tough(3) which occupy 3 spaces each. Transports may deploy with units inside, and units may enter/exit by using any move action, getting within 2” to enter, and staying fully within 6” when exiting. Units inside/outside transports may not target other units that are outside/inside, but may target the transport itself. When a transport is destroyed, units inside must take a Dangerous Terrain Test, are Shaken, and must be placed fully within 6” of the transport before it’s removed.","Unique Hero":"Counts as having Hero, and this model may only be taken once per army.","Unstoppable":"This weapon ignores Regeneration, and ignores all negative modifiers which are not from this model's special rules.","Unstoppable Mark":"Once per activation, before attacking, pick one enemy unit within 18\" in line of sight, which friendly units gets Unstoppable on their weapons against once (next time the effect would apply).","Unstoppable when Shooting":"This model gets Unstoppable on its weapons when shooting.","Unstoppable when Shooting Aura":"This model and its unit get Unstoppable on its weapons when shooting.","Vanguard":"After this model is deployed, it may be placed anywhere fully within 9\" of its position, over 9\" away from non-Vanguard enemy units.","Versatile Expert":"When this unit is activated, pick one effect: until the end of the activation all models with this rule in this unit either get AP(+1) when attacking, or get +1 to hit rolls when attacking.","Versatile Reach":"When this unit is activated, pick one effect: until the end of the activation, all models with this rule in this unit either get +4\" range when shooting or move +2\" when charging.","Versatile Reach Aura":"This model and its unit get Versatile Reach.","Vigilant":"Gets +1 to hit rolls when shooting.","Weakened":"Gets -1 to Defense rolls when blocking hits."},"rules_version":"3.6.0","saved_at":"2026-10-30T12:24:32","solo_ai_slots":[2.0],"table":{"biome":"temperate_grassland","custom_zones":{"player1":[],"player2":[]},"deployment_type":1.0,"grid_cells":{"10,10":2.0,"10,6":3.0,"10,8":2.0,"10,9":2.0,"11,13":3.0,"11,15":1.0,"11,16":1.0,"11,17":1.0,"12,10":3.0,"12,13":3.0,"12,15":1.0,"12,16":1.0,"12,17":1.0,"13,10":3.0,"13,15":1.0,"13,16":1.0,"13,17":1.0,"13,4":1.0,"13,5":1.0,"14,4":1.0,"14,5":1.0,"15,4":1.0,"15,5":1.0,"16,10":4.0,"16,11":4.0,"16,12":4.0,"17,10":4.0,"17,11":4.0,"17,12":4.0,"18,4":4.0,"18,5":4.0,"18,6":4.0,"19,4":4.0,"19,5":4.0,"19,6":4.0,"4,10":2.0,"4,5":1.0,"4,6":1.0,"4,8":2.0,"4,9":2.0,"5,10":2.0,"5,12":2.0,"5,13":2.0,"5,14":2.0,"5,5":1.0,"5,6":1.0,"5,8":2.0,"5,9":2.0,"6,10":2.0,"6,12":2.0,"6,13":2.0,"6,14":2.0,"6,17":2.0,"6,18":2.0,"6,19":2.0,"6,5":1.0,"6,6":1.0,"6,8":2.0,"6,9":2.0,"7,12":2.0,"7,13":2.0,"7,14":2.0,"7,17":2.0,"7,18":2.0,"7,19":2.0,"8,10":2.0,"8,17":2.0,"8,18":2.0,"8,19":2.0,"8,8":2.0,"8,9":2.0,"9,10":2.0,"9,6":3.0,