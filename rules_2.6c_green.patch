+## Step 2.6c: the hotseat round-start Ambush step. There is no AI seat to pace its own arrivals, so
+## both human sides are asked to place their reserve units, ordered by the turn state — the opener's
+## side first, then the other (GF/AoF v3.5.1 p.13: "starting with the player that activates next").
+## Solo (human vs NACHTMAHR) keeps `_solo_alternate_ambush_arrivals`; the AI beat is untouched.
+func _hotseat_ambush_arrivals(round_number: int, opener: int) -> void:
+	if not _solo_hotseat_automatic() or solo_controller == null or table == null or opr_army_manager == null:
+		return
+	if round_number < 2:
+		return
+	await _solo_mission_reserve_rolls(round_number)   # D8a: a roles mission's reserve dice; no-op otherwise
+	var saved_human: int = solo_controller.human_slot
+	var saved_ai: int = solo_controller.ai_slot
+	for slot in [opener, 3 - opener]:
+		# The real per-side prompt reuses the tested "human Ambush turn" with the controller's slots
+		# pointed at `slot` (its owner tray, its beacons, the other side as the enemy), restored after.
+		solo_controller.human_slot = slot
+		solo_controller.ai_slot = 3 - slot
+		var pool: Array = []
+		for u in solo_controller.human_reserve_units():
+			var gu := u as GameUnit
+			if gu != null and SoloController.may_arrive_this_round(gu, round_number):
+				pool.append(gu)
+		if pool.is_empty():
+			continue
+		if battle_log != null:
+			_log_rule_event(BattleLog.Category.GENERAL,
+				"P%d Ambush (round %d): place one reserve unit from the tray" % [slot, round_number], true)
+		await _solo_ambush_human_turn(round_number, pool)
+	solo_controller.human_slot = saved_human
+	solo_controller.ai_slot = saved_ai
+
+
