; NML-1073 M1-5 — the OPTIONAL Rust rollout node (crate core/nml-core-godot).
;
; Rule R1 of record: this extension is optional. Godot loads it when the library
; below exists; when it does not, ClassDB has no "NmlCore", BattleSim.core_enabled()
; returns false and the GDScript path runs unchanged.
;
; LINUX + WINDOWS x86_64 — the .so/.dll are built by hand with
;   cargo build --release --manifest-path core/nml-core-godot/Cargo.toml
;   cargo build --release --target x86_64-pc-windows-gnu --manifest-path core/nml-core-godot/Cargo.toml
; (F7: the linux library lands in the one workspace target dir, core/target/release)
; and are NOT committed.
;
; Maintainer decision 11.09.2026 (coreship): the extension SHIPS inside the Linux
; AND Windows game exports, DORMANT — its presence alone changes no game byte. Both
; wake-up seams (BattleSim.core_enabled() for the search/move seams, the
; NML_OBJECTIVE_DOCTRINE rung for placement) stay behind their explicit env
; opt-in, and no difficulty preset arms them by default. macOS stays out for this
; work.
;
; THIS FILE IS A TEMPLATE, not the live manifest. Godot only loads files
; literally named *.gdextension, so this .in copy is inert on a plain checkout.
; core/install_gdextension.sh copies it to core/nml_core.gdextension (gitignored)
; when, and only when, the .so above exists — that is what keeps a checkout
; without the built library free of the load-error spam this ticket removed.

[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = false

[libraries]

linux.debug.x86_64 = "res://core/target/release/libnml_core_godot.so"
linux.release.x86_64 = "res://core/target/release/libnml_core_godot.so"
windows.debug.x86_64 = "res://core/target/x86_64-pc-windows-gnu/release/nml_core_godot.dll"
windows.release.x86_64 = "res://core/target/x86_64-pc-windows-gnu/release/nml_core_godot.dll"
